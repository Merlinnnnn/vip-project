generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  todo
  in_progress
  done
  overdue
}

model Task {
  id               String        @id @default(uuid())
  userId           String
  title            String
  description      String?
  status           TaskStatus    @default(todo)
  priority         Int           @default(0)
  estimatedMinutes Int           @default(0)
  dueDate          DateTime      @default(now())
  skillId          String?
  skill            Skill?        @relation(fields: [skillId], references: [id], onDelete: SetNull)
  sessions         WorkSession[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Skill {
  id            String        @id @default(uuid())
  userId        String
  name          String
  totalMinutes  Int           @default(0)
  targetMinutes Int           @default(600000) // default target: 10,000 hours
  tasks         Task[]
  sessions      WorkSession[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, name])
}

model WorkSession {
  id          String    @id @default(uuid())
  userId      String
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  skillId     String?
  skill       Skill?    @relation(fields: [skillId], references: [id], onDelete: SetNull)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationMin Int       @default(0)
  note        String?
  createdAt   DateTime  @default(now())

  @@index([userId, startedAt])
  @@index([skillId, startedAt])
  @@index([taskId])
}

/// Outbox Pattern — lưu events cần publish lên RabbitMQ.
/// Worker sẽ poll bảng này mỗi 5s và publish events chưa gửi.
model OutboxEvent {
  id          String   @id @default(uuid())
  routingKey  String                        // vd: 'task.due_soon' | 'skill.level_up'
  payload     Json                          // nội dung event
  status      String   @default("pending")  // 'pending' | 'sent' | 'failed'
  attempts    Int      @default(0)          // số lần thử gửi
  createdAt   DateTime @default(now())
  processedAt DateTime?                     // thời điểm gửi thành công

  @@index([status, createdAt])              // index để query pending events nhanh
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
