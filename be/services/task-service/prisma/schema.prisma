generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  todo
  in_progress
  done
  overdue
}

model Task {
  id              String     @id @default(uuid())
  userId          String
  title           String
  description     String?
  status          TaskStatus @default(todo)
  priority        Int        @default(autoincrement())
  learningMinutes Int        @default(0)
  dueDate         DateTime   @default(now())
  skillId         String?
  skill           Skill?     @relation(fields: [skillId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Skill {
  id            String   @id @default(uuid())
  userId        String
  name          String
  totalMinutes  Int      @default(0)
  targetMinutes Int      @default(600000) // default target: 10,000 hours
  tasks         Task[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, name])
}

/// Outbox Pattern — lưu events cần publish lên RabbitMQ.
/// Worker sẽ poll bảng này mỗi 5s và publish events chưa gửi.
model OutboxEvent {
  id          String   @id @default(uuid())
  routingKey  String                        // vd: 'task.due_soon' | 'skill.level_up'
  payload     Json                          // nội dung event
  status      String   @default("pending")  // 'pending' | 'sent' | 'failed'
  attempts    Int      @default(0)          // số lần thử gửi
  createdAt   DateTime @default(now())
  processedAt DateTime?                     // thời điểm gửi thành công

  @@index([status, createdAt])              // index để query pending events nhanh
}
