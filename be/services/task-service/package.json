{
  "name": "task-service",
  "version": "0.0.1",
  "private": true,
  "description": "Task service scaffold (Node.js + Express + layered architecture).",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init_tasks",
    "lint": "echo \"add eslint if needed\"",
    "test": "echo \"add tests\""
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "amqplib": "^0.10.9",
    "bullmq": "^5.74.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.10.1",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.13",
    "prisma": "^5.11.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
